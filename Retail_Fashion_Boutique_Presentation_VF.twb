    <dashboard enable-sort-zone-taborder='true' name='8'>
      <style />
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' preset-index='8' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='10761' id='28' type-v2='text' w='94047' x='3421' y='889'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='22'>RECOMMENDATIONS</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='98222' id='41' param='horz' type-v2='layout-flow' w='2921' x='500' y='889' />
          <zone h='98222' id='50' param='horz' type-v2='layout-flow' w='2032' x='97468' y='889' />
          <zone h='6586' id='59' param='vert' type-v2='layout-flow' w='94047' x='3421' y='11650' />
          <zone h='80875' id='60' param='vert' type-v2='layout-flow' w='94047' x='3421' y='18236' />
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='61889' id='79' type-v2='text' w='69625' x='13063' y='24556'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='15'>IMPROVE SIZE CHATS &amp; PRODUCT INFORMATION</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10' lmargin='600' rmargin='600'>Provide detailed, easy-to-follow size charts and product sheets on the website, so customers buy with confidence.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true' lmargin='600' rmargin='600'>Why: “Size Issue” (18.8%) and “Color Mismatch” (14.4%) together account for about one in three returns. </run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true' lmargin='600' rmargin='600'>Summer has the highest return rate (17.4%), so fit and fabric of Summer pieces are worth checking.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='15'>REWARD CONSCIOUS PURCHASES IN LOYALTY PROGRAMS</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10' lmargin='600' rmargin='600'>Keep member benefits, but make clear that returned items reduce the points balance, to discourage impulse purchases. Pilot it before a full rollout.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true' lmargin='600' rmargin='600'>Why: “Changed Mind” is the top return reason (21.3%).</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='15'>LIMIT FREE ASSISTED RETURNS</run>
            <run lmargin='600' rmargin='600'>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10' lmargin='600' rmargin='600'>Offer free carrier-assisted returns only above a minimum order value or to premium customers, to reduce cost and environmental impact.</run>
            <run lmargin='600' rmargin='600'>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true' lmargin='600' rmargin='600'>Why: returns carry logistics costs and emissions (not measured in this dataset).</run>
          </formatted-text>
        </zone>
        <zone h='13333' id='80' is-centered='0' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/agulha_transparente.png' type-v2='bitmap' w='4563' x='32313' y='889' />
        <zone h='7778' id='87' is-centered='0' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/botao_1024_VF.png' type-v2='bitmap' w='4063' x='8000' y='26222' />
        <zone h='7778' id='88' is-centered='0' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/botao_1024_VF.png' type-v2='bitmap' w='4063' x='8000' y='48778' />
