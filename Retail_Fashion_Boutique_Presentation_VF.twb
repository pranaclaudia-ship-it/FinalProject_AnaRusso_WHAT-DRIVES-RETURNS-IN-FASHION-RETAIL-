    <worksheet name='Size'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='12'>Returns per Size</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='retail_fashion_tableau_v2' name='federated.06egux40g1pw4u18h44es07rmrog' />
            <datasource caption='Parâmetros' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Metric' datatype='string' name='[Parâmetro 1484399959506953]' param-domain-type='list' role='measure' type='nominal' value='&quot;Return rate&quot;'>
              <calculation class='tableau' formula='&quot;Return rate&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.06egux40g1pw4u18h44es07rmrog'>
            <column caption='Purchases' datatype='integer' name='[Calculation_1484397420232704]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([product_id])' />
            </column>
            <column caption='Returns' datatype='integer' name='[Calculation_1484397442494466]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([is_returned])' />
            </column>
            <column caption='Return Rate' datatype='real' default-format='p0.00%' name='[Calculation_1484397442682883]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([is_returned])' />
            </column>
            <column caption='Metric Value' datatype='real' name='[Calculation_1484399961432075]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parâmetro 1484399959506953]&#13;&#10;   WHEN &quot;Purchases&quot; THEN [Calculation_1484397420232704]&#13;&#10;   WHEN &quot;Returns&quot; THEN [Calculation_1484397442494466]&#13;&#10;   WHEN &quot;Return rate&quot; THEN [Calculation_1484397442682883]&#13;&#10;   END' />
            </column>
            <column caption='Metric Label' datatype='string' name='[Calculation_1484399963123724]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parâmetro 1484399959506953]&#13;&#10;   WHEN &quot;Return rate&quot; THEN STR(ROUND([Calculation_1484397442682883]*100,1)) + &quot;%&quot;&#13;&#10;   ELSE STR(ROUND([Calculation_1484399961432075],0))&#13;&#10;   END' />
            </column>
            <column caption='Overall rate' datatype='real' name='[Calculation_1484399979966477]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED : SUM([is_returned])} / {FIXED : COUNT([product_id])}' />
            </column>
            <column caption='Size color' datatype='string' name='[Calculation_2089681916530691]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF ATTR([size]) = &quot;No Info&quot; OR ATTR([size]) = &quot;Not applicable&quot; THEN &quot;No size&quot;&#13;&#10;   ELSEIF [Parameters].[Parâmetro 1484399959506953] = &quot;Return rate&quot; AND [Calculation_1484397442682883] &gt; AVG([Calculation_1484399979966477]) THEN &quot;Above&quot;&#13;&#10;   ELSE &quot;Other&quot; END' />
            </column>
            <column caption='Is Returned' datatype='integer' name='[is_returned]' role='measure' type='quantitative' />
            <column-instance column='[size]' derivation='None' name='[none:size:nk]' pivot='key' type='nominal' />
            <column caption='Product Id' datatype='string' name='[product_id]' role='dimension' type='nominal' />
            <column caption='Size' datatype='string' name='[size]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1484399979966477]' derivation='Sum' name='[sum:Calculation_1484399979966477:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1484399961432075]' derivation='User' name='[usr:Calculation_1484399961432075:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1484399963123724]' derivation='User' name='[usr:Calculation_1484399963123724:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2089681916530691]' derivation='User' name='[usr:Calculation_2089681916530691:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
