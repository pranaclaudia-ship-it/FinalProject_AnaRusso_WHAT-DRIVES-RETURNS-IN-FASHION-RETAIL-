        <zone forceUpdate='true' h='39778' id='79' type-v2='text' w='37125' x='12313' y='25667'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>Hypothesis 1: size</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H0: size is not associated with returns.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H1: size is associated with returns.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8' italic='true'>Only products with a size (Accessories and missing sizes excluded).</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>Hypothesis 2: price range</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H0: price range is not associated with returns.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H1: price range is associated with returns.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>Hypothesis 3: collection</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H0: return rate does not differ between collections.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H1: return rate differs between collections.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='4667' id='82' type-v2='text' w='73188' x='3438' y='15333'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Based on the SQL analysis and the visualizations shown earlier, three hypotheses were selected for statistical testing:</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='9444' id='83' type-v2='text' w='40063' x='3563' y='83667'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10' italic='true'>Method: chi-square test of independence</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10' italic='true'><![CDATA[Significance level: α = 0.05 | H0 is rejected when p < 0.05]]></run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
