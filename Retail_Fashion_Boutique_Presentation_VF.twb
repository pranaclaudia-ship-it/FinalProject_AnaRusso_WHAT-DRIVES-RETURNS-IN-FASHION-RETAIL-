          <zone h='6586' id='59' param='vert' type-v2='layout-flow' w='94047' x='3421' y='11650' />
          <zone h='80875' id='60' param='vert' type-v2='layout-flow' w='94047' x='3421' y='18236' />
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='36667' id='82' type-v2='text' w='56500' x='40813' y='51111'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>SIZE</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Return rates range from 13.3% (M, XXL) to 17.6% (L).</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>No logical pattern: extreme sizes are not consistently higher.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>PRICE RANGE</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Rates range from 13.2% (100–200 EUR) to 17.6% (200+ EUR), with no trend as price rises.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>200+ EUR has only 68 purchases, so its high rate may be noise.</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10'>COLLECTION</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Rates range from 11.9% (Fall) to 17.4% (Summer), the widest gap of the three variables.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>Summer and Winter are above the 14.7% overall rate; Spring and Fall are below.</run>
          </formatted-text>
        </zone>
        <zone h='36778' id='83' is-centered='0' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/tabela_resultados_hipoteses.png' type-v2='bitmap' w='94188' x='3375' y='15111' />
        <zone h='38778' id='84' name='Collection Pizza' w='28563' x='4375' y='48889' />
        <zone forceUpdate='true' h='10556' id='85' type-v2='text' w='28188' x='5625' y='89000'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Return rate by collection: Summer (17.4%) vs Fall (11.9%). </run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Chi-square p = 0.049 (H3): weak evidence of a difference.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Light' fontsize='8'>Slice size reflects each rate; rates do not sum to 100%.</run>
          </formatted-text>
        </zone>
        <zone h='13333' id='86' is-centered='0' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/agulha_transparente.png' type-v2='bitmap' w='4563' x='47375' y='2000' />
