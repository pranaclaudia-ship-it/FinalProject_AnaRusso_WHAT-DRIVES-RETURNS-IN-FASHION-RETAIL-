                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H1: price range is associated with returns.</run>
                    <run>Æ&#10;&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='14'>Hypothesis 3: collection</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H0: return rate does not differ between collections.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>H1: return rate differs between collections.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='70' h='7778' id='84' is-centered='0' is-fixed='true' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/botao_1024_VF.png' type-v2='bitmap' w='4063' x='7063' y='28222'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='70' h='7778' id='85' is-centered='0' is-fixed='true' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/botao_1024_VF.png' type-v2='bitmap' w='4063' x='7063' y='43222'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='70' h='7778' id='86' is-centered='0' is-fixed='true' is-scaled='1' param='C:/Users/prana/OneDrive/Área de Trabalho/botao_1024_VF.png' type-v2='bitmap' w='4063' x='7063' y='56222'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='12444' id='87' type-v2='text' w='93375' x='3563' y='67667'>
                  <formatted-text>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>These three were chosen for their direct business impact: </run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Tableau Light' fontsize='10'>size (size charts and patterns), price range (financial impact and customer purchasing profile) and collection (fabric type and pattern making).</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='9444' id='83' type-v2='text' w='40063' x='3563' y='83667'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10' italic='true'>Method: chi-square test of independence</run>
                    <run>Æ&#10;</run>
                    <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='10' italic='true'><![CDATA[Significance level: α = 0.05 | H0 is rejected when p < 0.05]]></run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='1' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='8' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
